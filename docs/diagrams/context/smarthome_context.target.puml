@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Тёплый дом — контекст целевой системы (To-Be)

Person(user, "Пользователь", "Самостоятельно подключает и настраивает умный дом")

System(smarthome, "Тёплый дом", "SaaS-платформа управления устройствами, мониторинга и автоматизации")

System_Ext(devices, "Управляемые устройства", "Отопление, освещение, замки ворот и новые типы устройств")
System_Ext(sensors, "Датчики", "Температурные и другие датчики")
System_Ext(cameras, "Камеры", "Удалённое видеонаблюдение")

Rel(user, smarthome, "Подключает и удаляет устройства, управляет ими, настраивает сценарии и расписания")
Rel(smarthome, user, "Предоставляет телеметрию, результаты команд и доступ к видеонаблюдению")
Rel(smarthome, devices, "Отправляет команды пользователя и сценариев", "Стандартные протоколы")
Rel(devices, smarthome, "Сообщают состояние и результаты выполнения команд", "Стандартные протоколы")
Rel(sensors, smarthome, "Передают показания", "Стандартные протоколы")
Rel(smarthome, cameras, "Запрашивает доступ к видеопотокам", "Стандартные протоколы")
Rel(cameras, smarthome, "Предоставляют видеопотоки", "Стандартные протоколы")

@enduml
